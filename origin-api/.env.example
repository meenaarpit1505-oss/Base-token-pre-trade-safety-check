# HTTP
PORT=8787

# Base JSON-RPC. State overrides (eth_call third argument) are required for
# honeypot / tax simulation. Public endpoints work for development; a dedicated
# node is what makes the sub-second p95 realistic.
# Code default when this is unset: https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
# Comma-separated. Used only when the primary URL fails a chain-id probe.
BASE_RPC_FALLBACKS=https://base.publicnode.com,https://1rpc.io/base

# Optional. Enables a second verified-ABI source and, when the plan allows it,
# Etherscan's tokenholderlist. Holder concentration does not require this key:
# Blockscout and GoPlus are queried without one. A free Etherscan key does not
# cover Base tokenholderlist.
ETHERSCAN_API_KEY=

# Sourcify is the no-key fallback for verified ABI. Override only if you run a mirror.
SOURCIFY_BASE_URL=https://sourcify.dev/server

# Holder indexes. Comma-separated: blockscout, goplus, etherscan.
# Blockscout (Base instance, no key) and GoPlus (no key) run by default.
# Successful lists are cached so a slow index does not sit on the next request.
HOLDER_SOURCES=blockscout,goplus,etherscan
BLOCKSCOUT_BASE_URL=https://base.blockscout.com
GOPLUS_BASE_URL=https://api.gopluslabs.io
# Optional. The public token_security endpoint works with no key.
# When set, the MCP scanner sends Authorization: Bearer <token>.
# Create the token in the GoPlus console (POST /api/v1/token with app_key,
# time, and sha1(app_key + time + app_secret)). Never commit a real token.
# GOPLUS_ACCESS_TOKEN=
# GoPlus request timeout for the MCP scanner. Code default is 8000. Minimum 100.
# GOPLUS_TIMEOUT_MS=8000

# MCP prepaid keys. Both are required or every check returns 402 (fail closed).
# The process does not crash at startup when they are unset. The HTTP API does not read them.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Never commit a real service-role key. It bypasses row level security.
HOLDER_CACHE_TTL_MS=600000

# In-memory success cache. 0 disables it.
CACHE_TTL_MS=20000

# Per-call price. The middleware records usage; it does not capture cards.
PRICE_USD=0.01

# open     — no credential required (local default). Usage is still counted under "anonymous".
# api_key  — require X-Api-Key matching one of API_KEYS. Unknown keys get 401.
# x402     — require PAYMENT-SIGNATURE (x402 v2) or, while the stub is on,
#            X-Payment: stub:<id>. Settlement runs only when both X402_PAY_TO
#            and X402_FACILITATOR_URL are set. See README "Going live with x402".
BILLING_MODE=open
API_KEYS=
X402_PAY_TO=
X402_ACCEPT_STUB=true
# X402_FACILITATOR_URL=https://facilitator.example
# X402_FACILITATOR_AUTH=
# X402_NETWORK=eip155:8453
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET_NAME=USD Coin
# X402_ASSET_VERSION=2

# Usage meter. Unset (or memory) keeps the counter in process memory.
# redis: REDIS_URL=redis:// or rediss://, or Upstash REST:
#   UPSTASH_REDIS_REST_URL=https://....upstash.io
#   UPSTASH_REDIS_REST_TOKEN=
# postgres: DATABASE_URL=postgres://...
# If both Redis and Postgres are set, USAGE_STORE must name one of them.
# USAGE_STORE=memory
# REDIS_URL=
# DATABASE_URL=

# Caps. These are ceilings, not targets. The orchestrator overlaps the slow calls.
SIM_TIMEOUT_MS=1200
# Caller waits this long for a holder list. The HTTP fetch may continue in the
# background and fill HOLDER_CACHE_TTL_MS so the next check is fast.
HOLDERS_TIMEOUT_MS=900
SOURCE_TIMEOUT_MS=500
# Code default when unset is 1500.
DISCOVERY_TIMEOUT_MS=1500

# Requests per IP per minute. 0 disables the limiter.
RATE_LIMIT_PER_MIN=120

# Concentrated-liquidity LP lock floor (src/services/lpLocks.ts). Burned position NFTs (0x...dEaD) are
# always indexed. Add operator-verified CL locker contracts (comma-separated) only from an official source.
# LP_NFT_LOCKERS=
# LP_NFT_INDEX_WARM=true
# LP_NFT_INDEX_REFRESH_MS=900000
# LP_NFT_INDEX_MAX_PER_HOLDER=10000
# Request-path wait for an unbuilt index. 0 = never wait (discovery has a 1.5 s budget).
# LP_NFT_INDEX_BUDGET_MS=0
