# --- Base RPC ---------------------------------------------------------------
# Primary RPC for state reads (multicall). A paid endpoint (Alchemy, QuickNode, Coinbase CDP...) is recommended.
BASE_RPC_URL=https://mainnet.base.org
# Comma-separated fallbacks. mainnet.base.org rejects eth_getLogs, so logs go to these first.
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com
# Optional dedicated endpoint for eth_getLogs (tried before the fallbacks).
BASE_LOGS_RPC_URL=

# --- Supabase cache (server-side only; never expose the service role key to browsers) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CACHE_TABLE=token_risk_cache
SUPABASE_READ_TIMEOUT_MS=250
SUPABASE_WRITE_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
MEMORY_CACHE_MAX_ENTRIES=5000

# --- Engine budgets ---------------------------------------------------------
ENGINE_TIMEOUT_MS=9500
CHECK_TIMEOUT_MS=7000
RPC_TIMEOUT_MS=4000
LOG_BLOCK_RANGE=1800
LOG_CHUNK_SIZE=1000
LOG_CONCURRENCY=4
LOG_ADDRESS_BATCH=10
LOG_MAX_POOLS=8
HEAD_LAG_BLOCKS=2
PENDING_SAMPLE_MS=600
MAX_TX_LOOKUPS=60

# --- Threat model tuning ----------------------------------------------------
# Comma-separated known MEV bot / searcher addresses (EOAs or contracts).
MEV_BOT_ADDRESSES=
# Extra router addresses to ignore when attributing swaps to actors.
KNOWN_ROUTER_ADDRESSES=
JIT_WINDOW_BLOCKS=5
JIT_MIN_LIQUIDITY_SHARE=0.05
CASCADE_SHOCK_PCT=30
REFERENCE_TRADE_USD=10000
WEIGHT_MEMPOOL=0.35
WEIGHT_JIT=0.30
WEIGHT_CASCADE=0.35

# --- Venue / quote-asset coverage (v2.1) ------------------------------------
# Uniswap V4 (PoolManager 0x498581ff718922c3f8e6a244956af099b2652b2b, StateView 0xa3c0c9b65bad0b08107aa264b0f3db444b867a71).
ENABLE_UNISWAP_V4=true
# Extra V4 pools, e.g. hooked pools that cannot be discovered by key guessing.
# Format: currency0,currency1,fee,tickSpacing,hooks;...  (native ETH = 0x0000000000000000000000000000000000000000)
UNISWAP_V4_POOL_KEYS=
# USDbC + cbBTC as intermediate quote assets (scored as two-hop routes into USDC/WETH).
ENABLE_EXTRA_QUOTES=true
# Pools below this USD depth are ignored (as long as at least one deeper pool exists).
DUST_POOL_USD=1000

# --- Concentrated-liquidity tick walk ----------------------------------------
# Deepest N CL pools get tick bitmaps (3 words) + liquidityNet of the nearest initialized ticks.
CL_TICK_SCAN_MAX_POOLS=6
CL_TICK_WALK_MAX_TICKS=8
# Skip the tick scan (use the provable tick-spacing bound) if context building already took this long.
CL_TICK_SCAN_BUDGET_MS=4500
