# --- Base RPC ---------------------------------------------------------------
# Primary RPC for state reads (multicall). A paid endpoint (Alchemy, QuickNode, Coinbase CDP...) is recommended.
BASE_RPC_URL=https://mainnet.base.org
# Comma-separated fallbacks. mainnet.base.org rejects eth_getLogs, so logs go to these first.
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com
# Optional dedicated endpoint for eth_getLogs (tried before the fallbacks).
BASE_LOGS_RPC_URL=

# --- Supabase cache (server-side only; never expose the service role key to browsers) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CACHE_TABLE=token_risk_cache
SUPABASE_READ_TIMEOUT_MS=250
SUPABASE_WRITE_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300
MEMORY_CACHE_MAX_ENTRIES=5000

# --- Engine budgets ---------------------------------------------------------
ENGINE_TIMEOUT_MS=9500
CHECK_TIMEOUT_MS=7000
RPC_TIMEOUT_MS=4000
LOG_BLOCK_RANGE=1800
LOG_CHUNK_SIZE=1000
LOG_CONCURRENCY=4
LOG_ADDRESS_BATCH=10
LOG_MAX_POOLS=8
HEAD_LAG_BLOCKS=2
PENDING_SAMPLE_MS=600
MAX_TX_LOOKUPS=60

# --- Threat model tuning ----------------------------------------------------
# Comma-separated known MEV bot / searcher addresses (EOAs or contracts).
MEV_BOT_ADDRESSES=
# Extra router addresses to ignore when attributing swaps to actors.
KNOWN_ROUTER_ADDRESSES=
JIT_WINDOW_BLOCKS=5
JIT_MIN_LIQUIDITY_SHARE=0.05
CASCADE_SHOCK_PCT=30
REFERENCE_TRADE_USD=10000
WEIGHT_MEMPOOL=0.35
WEIGHT_JIT=0.30
WEIGHT_CASCADE=0.35

# --- Venue / quote-asset coverage (v2.1) ------------------------------------
# Uniswap V4 (PoolManager 0x498581ff718922c3f8e6a244956af099b2652b2b, StateView 0xa3c0c9b65bad0b08107aa264b0f3db444b867a71).
ENABLE_UNISWAP_V4=true
# Extra V4 pools, e.g. hooked pools that cannot be discovered by key guessing.
# Format: currency0,currency1,fee,tickSpacing,hooks;...  (native ETH = 0x0000000000000000000000000000000000000000)
UNISWAP_V4_POOL_KEYS=
# USDbC + cbBTC as intermediate quote assets (scored as two-hop routes into USDC/WETH).
ENABLE_EXTRA_QUOTES=true
# Pools below this USD depth are ignored (as long as at least one deeper pool exists).
DUST_POOL_USD=1000

# --- Concentrated-liquidity tick walk ----------------------------------------
# Deepest N CL pools get tick bitmaps (3 words) + liquidityNet of the nearest initialized ticks.
CL_TICK_SCAN_MAX_POOLS=6
CL_TICK_WALK_MAX_TICKS=8
# Skip the tick scan (use the provable tick-spacing bound) if context building already took this long.
CL_TICK_SCAN_BUDGET_MS=4500

# --- Uniswap V4 Initialize-log discovery (v2.2) --------------------------------
# Finds hooked / non-standard-tier V4 pools from PoolManager Initialize logs (token as currency0 or currency1).
# auto (default): on only when BASE_LOGS_RPC_URL is set, or BASE_RPC_URL is a logs-capable endpoint
#                 (anything but mainnet.base.org). With the defaults above it stays off.
# on:  also use BASE_RPC_FALLBACK_URLS (e.g. publicnode, 50k-block ranges).   off: disabled.
UNISWAP_V4_LOG_DISCOVERY=auto
V4_DISCOVERY_LOOKBACK_BLOCKS=500000
V4_DISCOVERY_CHUNK_BLOCKS=50000
# Max wait per request; a slower scan keeps running and serves the next call from memory.
V4_DISCOVERY_BUDGET_MS=2500
V4_DISCOVERY_CACHE_SECONDS=1800
V4_DISCOVERY_MAX_POOLS=12

# --- Billing (v2.2, optional) ------------------------------------------------------
# open (default): free, unchanged behaviour.
# api_key: callers send X-Api-Key; each paid call runs Supabase RPC deduct_api_key_balance (needs SUPABASE_URL +
#          SUPABASE_SERVICE_ROLE_KEY and origin-api/supabase/migrations/20261105120000_api_keys.sql applied).
# x402:    unpaid calls get HTTP 402 + PAYMENT-REQUIRED (x402 v2, USDC on Base). Needs X402_PAY_TO (your own
#          receiving wallet, public address only) and X402_FACILITATOR_URL. Nothing is built in.
# Any non-open mode with missing config answers 503 (fail closed) instead of serving free results.
BILLING_MODE=open
PRICE_USD=0.01
X402_PAY_TO=
X402_FACILITATOR_URL=
# Optional facilitator credential (sent as Authorization: Bearer ... unless it already has a scheme).
X402_FACILITATOR_AUTH=
# Testing only: accept "X-Payment: stub:<client-id>" without settlement. Keep false in production.
X402_ACCEPT_STUB=false
# X402_NETWORK=eip155:8453
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET_NAME=USD Coin
# X402_ASSET_VERSION=2
# X402_MAX_TIMEOUT_SECONDS=60
# X402_VERIFY_TIMEOUT_MS=2500
# X402_SETTLE_TIMEOUT_MS=8000
